[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    protected-access,
    import-outside-toplevel,
    trailing-whitespace,
    unused-argument,
    multiple-statements,
    unused-variable,
    invalid-name,
    redefined-outer-name,
    reimported,
    no-member,
    multiple-imports,
    line-too-long,
    wrong-import-position,
    unused-import,
    broad-exception-caught,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    unnecessary-lambda-assignment,
    too-few-public-methods,
    too-many-statements,
    too-many-locals,
    too-many-lines,
    missing-final-newline

[TYPECHECK]
ignored-modules=tkinter

[SIMILARITIES]
# The validate-and-unpack idiom at the _get_connection_inputs() call boundary
# is 5 similar lines shared by the connection and profile controllers. Its
# early return exits the *caller*, so it cannot be hoisted into a helper
# without raising an exception through GUI event handlers -- worse than the
# duplication it would remove. Keep duplicate-code on for genuine duplication;
# raise the threshold just past this idiom.
min-similarity-lines=6
